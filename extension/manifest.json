{
  "manifest_version": 3,
  "name": "Our House Hunt Importer 0.17.0",
  "version": "0.17.0",
  "description": "Imports original listings, floor plans and scheduled Google Maps journeys.",
  "permissions": [
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://www.zoopla.co.uk/*",
    "https://zoopla.co.uk/*",
    "https://www.rightmove.co.uk/*",
    "https://rightmove.co.uk/*",
    "https://*.zoocdn.com/*",
    "https://*.rightmove.co.uk/*",
    "https://www.google.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://sabinacoaching.github.io/our-house-hunt/*",
        "https://sabinacoaching.github.io/Our-house-hunt/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start"
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
